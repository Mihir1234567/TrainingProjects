          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/jobs",
              "host": ["{{base_url}}"],
              "path": ["jobs"]
            }
          },
          "response": []
        },
        {
          "name": "Create Job (Employer Only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Senior React Developer\",\n    \"description\": \"We are looking for an experienced React developer...\",\n    \"category\": \"Technology\",\n    \"type\": \"Full Time\",\n    \"location\": \"Remote\",\n    \"salaryRange\": {\n        \"min\": 80000,\n        \"max\": 120000\n    }\n}"
            },
            "url": {
              "raw": "{{base_url}}/jobs",
              "host": ["{{base_url}}"],
              "path": ["jobs"]
            }
          },
          "response": []
        },
        {
